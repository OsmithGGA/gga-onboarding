# Copy this file to .env.local and fill in your values

# ─── Supabase ─────────────────────────────────────────────
# Get these from: supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── Site URL ─────────────────────────────────────────────
# Local: http://localhost:3000
# Production: https://your-app.vercel.app (or custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Google Drive ─────────────────────────────────────────
# 1. Create a Google Cloud project
# 2. Enable the Google Drive API
# 3. Create a Service Account and download its JSON key
# 4. Paste the ENTIRE JSON as a single string (escape line breaks)
# 5. Create a folder in Google Drive, share it with the service account email
# 6. Copy the folder ID from its URL (...drive.google.com/drive/folders/FOLDER_ID)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_DRIVE_PARENT_FOLDER_ID=your_parent_folder_id

# ─── Resend (email notifications) ─────────────────────────
# Get free API key at: resend.com
# Add and verify your domain in Resend dashboard
RESEND_API_KEY=re_your_key_here

# ─── Admin Panel ──────────────────────────────────────────
# Choose a strong password — used to access /admin
ADMIN_PASSWORD=choose-a-strong-password

# ─── Notifications ────────────────────────────────────────
NOTIFICATION_EMAIL=oransmith03@gmail.com
